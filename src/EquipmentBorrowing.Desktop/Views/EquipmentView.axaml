<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:domain="using:EquipmentBorrowing.Domain.Entities"
             x:Class="EquipmentBorrowing.Desktop.Views.EquipmentView"
             x:DataType="vm:EquipmentViewModel">
    <StackPanel Spacing="12">
        <TextBlock Classes="heading" Text="Equipment catalog"/>
        <TextBlock Text="Select an item to edit it, view its history, or check it out."/>
        <TextBlock Text="{Binding LoadMessage}" TextWrapping="Wrap"/>
        <WrapPanel>
            <Button Content="Show all equipment" Command="{Binding ShowAllEquipmentCommand}"/>
            <Button Content="Available only" Command="{Binding ShowAvailableEquipmentCommand}"/>
            <Button Content="Refresh catalog" Command="{Binding RetryLoadCommand}"/>
        </WrapPanel>
        <DataGrid Height="250"
                  ItemsSource="{Binding EquipmentList}"
                  SelectedItem="{Binding SelectedEquipment}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="All">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Identifier" Binding="{Binding Identifier}" Width="150"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridCheckBoxColumn Header="Available" Binding="{Binding IsAvailable}" IsReadOnly="True" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Classes="section-label" Text="Single-item checkout"/>
        <WrapPanel>
            <ComboBox Width="280"
                      ItemsSource="{Binding Students}"
                      SelectedItem="{Binding SelectedStudent}"
                      PlaceholderText="Select student">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="domain:Student">
                        <TextBlock>
                            <Run Text="{Binding StudentNumber}"/>
                            <Run Text=" — "/>
                            <Run Text="{Binding FullName}"/>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <DatePicker SelectedDate="{Binding ExpectedReturnDate}"/>
            <Button Content="Borrow selected equipment"
                    Command="{Binding BorrowSelectedEquipmentCommand}"/>
        </WrapPanel>

        <TextBlock Classes="section-label" Text="Register equipment"/>
        <WrapPanel>
            <TextBox Classes="form-control" Width="150" MaxLength="50"
                     Watermark="Equipment ID" Text="{Binding NewIdentifier}"/>
            <TextBox Classes="form-control" Width="200" MaxLength="150"
                     Watermark="Name" Text="{Binding NewName}"/>
            <TextBox Classes="form-control" Width="240" MaxLength="500"
                     Watermark="Description (optional)" Text="{Binding NewDescription}"/>
            <Button Content="Register" Command="{Binding RegisterEquipmentCommand}"/>
        </WrapPanel>

        <TextBlock Classes="section-label" Text="Edit selected equipment"/>
        <WrapPanel>
            <TextBox Classes="form-control" Width="150" MaxLength="50"
                     Watermark="Equipment ID" Text="{Binding EditIdentifier}"/>
            <TextBox Classes="form-control" Width="200" MaxLength="150"
                     Watermark="Name" Text="{Binding EditName}"/>
            <TextBox Classes="form-control" Width="240" MaxLength="500"
                     Watermark="Description (optional)" Text="{Binding EditDescription}"/>
            <Button Content="Save details" Command="{Binding UpdateEquipmentCommand}"/>
            <Button Content="View item history" Command="{Binding LoadEquipmentHistoryCommand}"/>
        </WrapPanel>
        <TextBlock Text="Availability and borrowing history are changed only by checkout and return workflows."/>
        <DataGrid Height="150"
                  ItemsSource="{Binding EquipmentHistory}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="All">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Student" Binding="{Binding Student.StudentNumber}" Width="130"/>
                <DataGridTextColumn Header="Checkout" Binding="{Binding CheckoutDate}" Width="130"/>
                <DataGridTextColumn Header="Expected return" Binding="{Binding ExpectedReturnDate}" Width="160"/>
                <DataGridTextColumn Header="Returned" Binding="{Binding ActualReturnDate}" Width="130"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>
